# Dependências
node_modules/
**/node_modules/

# Build / Next.js
.next/
**/.next/
out/
dist/
build/

# Ambiente / segredos
.env
.env.local
.env.*
!.env.example
# Deploy: envs reais e dump de schema (nunca versionar).
# Regra geral: qualquer *.env em deploy/ é segredo; só os *.example entram no git.
saas-multitenant/deploy/*.env
!saas-multitenant/deploy/*.env.example
saas-multitenant/deploy/.env
saas-multitenant/deploy/schema.sql

# Vercel (arquivos gerados pela CLI/painel — contêm IDs do projeto)
.vercel
**/.vercel

# Backups e dumps de banco (nunca versionar)
backups/
**/backups/
*.dump
*.sql.gz
*.tar.gz
admin-credentials.txt

# Chaves privadas, certificados e tokens
*.pem
*.key
id_rsa*
*.tfstate
cloudflared-*.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads de usuários (não versionar dados)
saas-multitenant/backend/uploads/

# Editores / ferramentas
.cursor/
.auxly/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Artefatos inválidos de operações antigas (nomes malformados)
/_/
/_parameter name=*

# Cobertura de testes
coverage/

# ============================================================
# SISV — Backend. Copie para .env e preencha com os valores REAIS do ambiente.
# NUNCA commite o arquivo .env. Todos os valores abaixo são FICTÍCIOS.
#
# A configuração é validada no startup (backend/config/env.js): em produção o
# servidor NÃO sobe com segredo padrão, CORS aberto ou modo demo habilitado.
# ============================================================

# ---------------------------------------------------------
# OBRIGATÓRIO — Banco PostgreSQL isolado do SISV.
# Nunca aponte para o banco de outro sistema/tenant.
# Formato: postgres://usuario:senha@host:5432/banco?sslmode=require
# ---------------------------------------------------------
DATABASE_URL=postgresql://sisv_user:SENHA_AQUI@db.exemplo.local:5432/sisv?sslmode=require

# ---------------------------------------------------------
# OBRIGATÓRIO — Segredo do JWT (mínimo 32 caracteres em produção).
# Gere o seu:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------
JWT_SECRET=troque-por-um-segredo-gerado-com-no-minimo-32-caracteres

# ---------------------------------------------------------
# Ambiente e porta.
# NODE_ENV: development | homologation | production
# ---------------------------------------------------------
NODE_ENV=development
PORT=5000

# ---------------------------------------------------------
# OBRIGATÓRIO EM PRODUÇÃO — Origem(ns) permitida(s) no CORS.
# Sem curinga (*). Use o domínio real do frontend do SISV.
# EXTRA_CORS_ORIGINS aceita uma lista separada por vírgula.
# ---------------------------------------------------------
FRONTEND_URL=https://app.seu-dominio.exemplo
EXTRA_CORS_ORIGINS=

# ---------------------------------------------------------
# URL pública desta API (usada para montar links de arquivo).
# ---------------------------------------------------------
BASE_URL=https://api.seu-dominio.exemplo

# ---------------------------------------------------------
# Armazenamento de arquivos (hoje: disco local em backend/uploads).
# UPLOAD_MAX_MB: limite por arquivo (teto de segurança: 50).
# ---------------------------------------------------------
UPLOAD_MAX_MB=10

# ---------------------------------------------------------
# SSL do banco: defina false apenas para PostgreSQL local sem TLS.
# ---------------------------------------------------------
# DB_SSL=false

# ---------------------------------------------------------
# Senhas iniciais do seed (OPCIONAL). Se ausentes, o seed gera senhas
# aleatórias e as imprime UMA única vez. Nunca versione valores reais.
# ---------------------------------------------------------
# SISV_ADMIN_PASSWORD=
# SISV_OPERADOR1_PASSWORD=

# ---------------------------------------------------------
# SMTP (OPCIONAL). Sem isso, o envio de e-mail fica desabilitado
# sem quebrar o sistema. SMTP_SECURE=true para porta 465.
# ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SISV <no-reply@seu-dominio.exemplo>"

# ============================================================
# SISV — arquivos que NUNCA devem ser versionados.
# Os templates .env.example (sem valores reais) SÃO versionados.
# ============================================================

# Variáveis de ambiente — NUNCA commitar valores reais
.env
.env.*
backend/.env
backend/.env.*
# Exceções: templates com valores fictícios
!.env.example
!backend/.env.example

# Dependências
node_modules/
backend/node_modules/

# Build Next.js
.next/
out/

# Uploads de usuários (dados — nunca versionar)
backend/uploads/

# Logs
*.log
npm-debug.log*
logs/

# Vercel (contém IDs do projeto)
.vercel

# Cobertura de testes
coverage/

# Artefatos locais do Playwright e inspeção de traces
test-results/
playwright-report/
trace-inspect-*/

# Cluster PostgreSQL local e descartavel usado por npm run test:postgres
backend/.postgres-test/

.vercel

# Artefatos gerados (render intermediario e PDFs de manual) — nao versionar
tmp/
output/

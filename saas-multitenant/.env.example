# ============================================================
# SISV — Frontend (Next.js). Copie para .env.local e ajuste.
# NUNCA commite .env.local. Todos os valores abaixo são FICTÍCIOS.
#
# Variáveis NEXT_PUBLIC_* vão para o bundle do navegador:
# NUNCA coloque segredo aqui.
# ============================================================

# ---------------------------------------------------------
# Backend para onde o Next faz proxy de /api e /auth (next.config.js).
# Em desenvolvimento: http://localhost:5000
# ---------------------------------------------------------
BACKEND_URL=http://localhost:5000

# ---------------------------------------------------------
# URL pública do backend, usada apenas no upload direto (evita o limite
# de body do proxy). Deixe vazio em desenvolvimento para usar o proxy.
# ---------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=

# ---------------------------------------------------------
# Identidade institucional (marca exibida em login/rodapé/metadados).
# Padrão do produto: SISV / TELUN. Ajuste apenas se a marca mudar.
# ---------------------------------------------------------
NEXT_PUBLIC_APP_NAME=SISV
NEXT_PUBLIC_APP_TAGLINE=Sistema Integrado da Sinal Verde
NEXT_PUBLIC_APP_DEVELOPER=TELUN
NEXT_PUBLIC_BRAND_COLOR=#A56FFF
NEXT_PUBLIC_BRAND_COLOR_DARK=#3B1F6A
NEXT_PUBLIC_SUPPORT_EMAIL=suporte@seu-dominio.exemplo

# Assets oficiais isolados. Deixe vazio enquanto os SVG/PNG aprovados não
# estiverem disponíveis; a interface usará fallback tipográfico, sem fabricar
# ou recortar uma logo a partir do brand board.
NEXT_PUBLIC_TELUN_LOGO_URL=
NEXT_PUBLIC_TELUN_SYMBOL_URL=
NEXT_PUBLIC_SISV_FAVICON_URL=

# ============================================================
# SISV — token do Cloudflare Tunnel nomeado (api-sisv.chronostek.com.br).
#
# Copie para deploy/sisv-tunnel.env, cole o token REAL e proteja:
#   chmod 600 deploy/sisv-tunnel.env
#
# O arquivo real está no .gitignore e NUNCA deve ser versionado nem colado em
# chat/ticket. Se um token vazar, revogue-o no painel Cloudflare
# (Zero Trust → Networks → Tunnels → o túnel → Refresh token) — o valor abaixo
# é apenas um placeholder.
#
# A rota pública é configurada no painel, não aqui:
#   Public hostname: api-sisv.chronostek.com.br
#   Service:         http://sisv-backend:5000
# ============================================================

TUNNEL_TOKEN=cole-aqui-o-token-do-tunel-sisv

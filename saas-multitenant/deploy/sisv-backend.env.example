# ============================================================
# SISV — variáveis do container do backend (deploy).
# Copie para deploy/sisv-backend.env, preencha e proteja:  chmod 600
# O arquivo real está no .gitignore e NUNCA deve ser versionado.
# Todos os valores abaixo são FICTÍCIOS.
# ============================================================

# Banco interno da stack SISV (host = nome do serviço no compose).
# Nunca aponte para o banco de outro sistema.
DATABASE_URL=postgres://sisv:SENHA_DO_POSTGRES@postgres:5432/sisv?sslmode=disable

# Segredo próprio (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-gerado-de-no-minimo-32-caracteres

NODE_ENV=production
PORT=5000

# Origem(ns) do frontend para o CORS — sem curinga.
FRONTEND_URL=https://app.seu-dominio.exemplo
EXTRA_CORS_ORIGINS=

# URL pública desta API (monta links de arquivo).
BASE_URL=https://api.seu-dominio.exemplo

# Limite de upload por arquivo (MB).
UPLOAD_MAX_MB=10

# Credenciais do Postgres do compose (usadas pelo serviço postgres).
POSTGRES_USER=sisv
POSTGRES_PASSWORD=SENHA_FORTE_DO_POSTGRES
POSTGRES_DB=sisv
